NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Identity Services client ID - must be the exact same client ID the
# backend has as GOOGLE_CLIENT_ID (Backend/.env), since the backend verifies
# the ID token's audience against it. Not a secret - safe to ship in the
# client bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
